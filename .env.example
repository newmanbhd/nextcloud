# Login for the web interface (required)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Host folder for video files (docker compose only)
RECORDINGS_PATH=./data/recordings

# Retention: delete recordings older than N days (0 = keep forever)
RETENTION_DAYS=14
# Retention: cap total recordings size in GB (0 = no cap)
MAX_STORAGE_GB=0
# Retention: always keep at least this much disk free, deleting oldest first
MIN_FREE_GB=5

# How long a login lasts
SESSION_HOURS=12
# Set to 1 when running behind a reverse proxy (nginx, Caddy, Traefik)
TRUST_PROXY=0

# Time zone used for recording file names, e.g. Australia/Sydney
TZ=UTC
